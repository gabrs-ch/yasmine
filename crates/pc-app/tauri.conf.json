{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yasmine",
  "version": "0.5.3",
  "identifier": "ch.gabrs.yasmine",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "ui" }
  },
  "app": {
    "windows": [
      {
        "title": "Yasmine",
        "width": 1080,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis"],
    "category": "Music",
    "shortDescription": "Local music player with direct LAN sync.",
    "longDescription": "Yasmine plays your local music library and syncs playlists directly between your devices over the LAN — no account, no cloud, no server. Point it at a folder; to sync, point it at the other device.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["mp3", "flac", "m4a", "ogg", "opus", "wav", "aiff", "aif"],
        "name": "Audio",
        "description": "Audio file",
        "mimeType": "audio/mpeg;audio/flac;audio/mp4;audio/ogg;audio/opus;audio/wav;audio/aiff",
        "role": "Viewer"
      }
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
